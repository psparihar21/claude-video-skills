{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/faceless-vo-script/edit-package.schema.json",
  "title": "Edit package",
  "description": "Locked cut handed from a video-editing skill to the faceless voiceover skill.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "platform", "format", "video_duration_sec", "shots"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "platform": {
      "type": "string",
      "enum": ["youtube-shorts", "youtube-long", "reels", "tiktok", "instagram-feed"]
    },
    "format": {
      "type": "string",
      "enum": [
        "faceless-explainer",
        "faceless-story",
        "faceless-gameplay",
        "story-over-gameplay"
      ]
    },
    "video_duration_sec": { "type": "number", "exclusiveMinimum": 0 },
    "video_path": { "type": "string" },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "audio_bed": {
      "type": "string",
      "enum": ["music-only", "gameplay-sfx", "silent", "dialogue-present"]
    },
    "editor_notes": { "type": "string" },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "in_sec", "out_sec", "visual", "energy", "cut_type"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "in_sec": { "type": "number", "minimum": 0 },
          "out_sec": { "type": "number", "exclusiveMinimum": 0 },
          "visual": { "type": "string", "minLength": 1 },
          "on_screen_text": { "type": "string" },
          "cut_type": {
            "type": "string",
            "enum": ["hard", "j-cut", "text-card", "zoom"]
          },
          "energy": {
            "type": "string",
            "enum": ["hook", "build", "payoff", "breather"]
          },
          "hold_for_read": { "type": "boolean" },
          "hold_in_sec": { "type": "number", "minimum": 0 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
