{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/faceless-vo-script/script-package.schema.json",
  "title": "Voiceover script package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "status",
    "register",
    "format",
    "platform",
    "video_duration_sec",
    "persona",
    "mic_note",
    "cues"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "type": "string", "enum": ["draft", "final"] },
    "register": { "type": "string", "enum": ["indian-english", "hinglish"] },
    "format": {
      "type": "string",
      "enum": [
        "faceless-explainer",
        "faceless-story",
        "faceless-gameplay",
        "story-over-gameplay"
      ]
    },
    "platform": {
      "type": "string",
      "enum": ["youtube-shorts", "youtube-long", "reels", "tiktok", "instagram-feed"]
    },
    "video_duration_sec": { "type": "number", "exclusiveMinimum": 0 },
    "persona": { "type": "string", "minLength": 1 },
    "mic_note": { "type": "string", "minLength": 1 },
    "archetype": { "type": "string", "enum": ["expert", "storyteller", "commentator"] },
    "edge_voice": { "type": "string", "minLength": 1 },
    "pronounce": {
      "type": "array",
      "items": { "$ref": "#/$defs/pronounce" }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "loop_closes_cue"],
      "properties": {
        "shape": {
          "type": "string",
          "enum": ["result-first", "question-stakes", "contrarian", "best-moment-teaser", "cold-open-rewind"]
        },
        "loop_closes_cue": { "type": "string", "pattern": "^c[0-9]+$" }
      }
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cue" }
    },
    "intentional_silence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["in_sec", "out_sec", "reason"],
        "properties": {
          "in_sec": { "type": "number", "minimum": 0 },
          "out_sec": { "type": "number", "exclusiveMinimum": 0 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recut_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "reason", "need"],
        "properties": {
          "shot_id": { "type": "string" },
          "reason": { "type": "string" },
          "need": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "pronounce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "say"],
      "properties": {
        "word": { "type": "string", "minLength": 1 },
        "say": { "type": "string", "minLength": 1 }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "shot_id",
        "role",
        "in_sec",
        "out_sec",
        "spoken",
        "performance",
        "emphasis"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^c[0-9]+$" },
        "shot_id": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["hook", "setup", "turn", "payoff", "breather", "cta"]
        },
        "in_sec": { "type": "number", "minimum": 0 },
        "out_sec": { "type": "number", "exclusiveMinimum": 0 },
        "spoken": { "type": "string", "minLength": 1 },
        "performance": { "type": "string", "minLength": 1 },
        "emphasis": {
          "type": "array",
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "fact_source": { "type": "string" },
        "mix_note": { "type": "string" },
        "pronounce": {
          "type": "array",
          "items": { "$ref": "#/$defs/pronounce" }
        }
      }
    }
  }
}
