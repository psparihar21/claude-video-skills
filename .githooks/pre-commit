#!/bin/sh
# Block a commit that would leak personal data or secrets. Enable with: git config core.hooksPath .githooks
for py in python3 python py; do
  if "$py" -c "import sys" >/dev/null 2>&1; then
    exec "$py" "$(git rev-parse --show-toplevel)/tools/privacy_scan.py" --staged
  fi
done
# Windows often has only the Store stub for python; uv brings its own
if command -v uv >/dev/null 2>&1; then
  exec uv run --no-project --quiet python "$(git rev-parse --show-toplevel)/tools/privacy_scan.py" --staged
fi
echo "pre-commit: no working Python found, privacy scan skipped" >&2
exit 1
